filters:
  and:
    - 'file.inFolder("Teoría musical/1. Curso cresciente")'
    - 'file.ext == "md"'
    - '!file.inFolder("_legacy/Curso creciente 2026-08/1. Sistema y plantillas")'
properties:
  file.name:
    displayName: Nota
  tipo:
    displayName: Tipo
  estado:
    displayName: Estado
  fase:
    displayName: Fase
  fecha_inicio:
    displayName: Inicio
  fecha_cierre:
    displayName: Cierre
  habilidad_principal:
    displayName: Habilidad
  evidencia_audio:
    displayName: Evidencia
  puntuacion:
    displayName: Puntuación
  file.mtime:
    displayName: Modificado
views:
  - type: table
    name: Proyectos
    filters:
      and:
        - 'tipo == "proyecto"'
    order:
      - file.name
      - estado
      - fase
      - fecha_inicio
      - fecha_cierre
      - habilidad_principal
      - evidencia_audio
      - puntuacion
      - file.mtime
  - type: table
    name: Semanas
    filters:
      and:
        - 'tipo == "semana"'
    order:
      - file.name
      - estado
      - fase
      - fecha_inicio
      - fecha_cierre
      - proyecto
      - habilidad_principal
      - horas_planeadas
      - horas_reales
  - type: table
    name: Sesiones
    filters:
      and:
        - 'tipo == "sesion"'
    order:
      - file.name
      - fecha
      - proyecto
      - habilidad_principal
      - duracion_min
      - energia_inicio
      - dolor_inicio
      - objetivo_cumplido
      - evidencia_audio
  - type: table
    name: Experimentos
    filters:
      and:
        - 'tipo == "experimento"'
    order:
      - file.name
      - estado
      - fecha_inicio
      - fecha_cierre
      - habilidad_principal
      - condicion_a
      - condicion_b
      - resultado
  - type: table
    name: Laboratorios
    filters:
      and:
        - 'tipo == "laboratorio"'
    order:
      - file.name
      - estado
      - fase
      - file.mtime
  - type: table
    name: Referencias
    filters:
      and:
        - 'tipo == "analisis-referencia"'
    order:
      - file.name
      - estado
      - artista_compositor
      - obra
      - fase
      - principio_transferible
      - aplicado
